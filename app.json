{
  "expo": {
    "name": "Suresh & Co",
    "slug": "suresh-and-co",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo-50-square.png",
    "scheme": "sureshandco",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/logo-50-square.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.sureshandco.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo-50-square.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.sureshandco.app"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "./withCustomIcons.js"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "c495668b-b344-451d-8bc4-b7fce6e1dfe5"
      }
    }
  }
}